# Copy to .env (never commit .env). Required in production unless marked optional.
NODE_ENV=development
PORT=8080
# PostgreSQL connection. Leave empty in development to use embedded PGlite.
DATABASE_URL=postgres://healthguard:healthguard@localhost:5432/healthguard
# Optional: folder for embedded PGlite data (empty = in-memory, lost on restart)
PGLITE_DIR=
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
JWT_TTL_SECONDS=28800
# Key for hashing NINs. Never change it after go-live, or NIN lookups stop matching.
NIN_HASH_KEY=
# Shared with the payment gateway; webhooks are signed with HMAC-SHA256 using it.
PAYMENT_WEBHOOK_SECRET=
# Optional: USSD aggregator must call /api/v1/ussd?key=<this>
USSD_SECRET=
CORS_ORIGINS=http://localhost:5173
# Optional: folder with the built frontend (npm run build → dist) to serve at /
STATIC_DIR=
# Load demo population + demo logins into an empty database (default: on outside production)
SEED_DEMO=false
