{
  "name": "healthguard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p server",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/index.js && esbuild server/cli.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/cli.js",
    "server:start": "node dist-server/index.js",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:seed": "tsx server/cli.ts seed",
    "dev:all": "concurrently -k -n api,web -c green,cyan \"npm:server:dev\" \"npm:dev\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^11.0.0",
    "@tanstack/react-query": "^5.108.4",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "lucide-react": "0.577.0",
    "pg": "^8.23.1",
    "qrcode.react": "4.2.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
